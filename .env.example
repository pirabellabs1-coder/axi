# ───────────── Axi — variables d'environnement ─────────────
# Copier en .env (jamais commité). Aucun secret ne doit apparaître dans le code ou l'historique Git.

# Base de données PostgreSQL (Supabase, Neon, Railway, ou locale)
DATABASE_URL="postgresql://user:password@localhost:5432/axi?schema=public"

# Secret applicatif (32+ caractères aléatoires) : sessions, chiffrement des clés de paiement, tokens
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En production, toute valeur contenant « change-me » est refusée.
APP_SECRET="change-me-change-me-change-me-change-me-change-me"

# URL publique de l'application et domaine racine des boutiques ({slug}.axi.africa)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
# Optionnel : URL interne utilisée par le proxy pour résoudre les domaines personnalisés
# (/api/domains/resolve). Par défaut : NEXT_PUBLIC_APP_URL. Jamais dérivée de l'en-tête Host.
INTERNAL_APP_URL=""

# E-mail transactionnel (vérification, réinitialisation, notifications).
# EMAIL_PROVIDER = console (dev uniquement : affiche dans le terminal, refusé en production) | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Axi <no-reply@axi.africa>"
RESEND_API_KEY=""

# Clé pour protéger l'endpoint du worker de tâches (cron) : en-tête `x-jobs-key: <clé>` sur /api/jobs/run
# (plus de ?key= dans l'URL). Vercel Cron : définir CRON_SECRET (envoyé en Authorization: Bearer).
# En production, toute valeur contenant « change-me » est refusée.
JOBS_RUN_KEY="change-me-jobs-key"
CRON_SECRET=""

# ───────────── Points d'intégration laissés au porteur ─────────────
# Facturation des abonnements plateforme (PlatformBillingProvider) :
PLATFORM_BILLING_PROVIDER="manual"      # manual | fedapay | kkiapay | stripe
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# IA (optionnel, P2) : assistant de rédaction produit. Vide = désactivé.
ANTHROPIC_API_KEY=""

# Compte admin plateforme créé au seed (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@axi.africa"
SEED_ADMIN_PASSWORD="Admin-Axi-2026!"
# Double authentification de l'équipe plateforme : obligatoire (0 ou absent). 1 = facultative, démo locale uniquement.
ADMIN_MFA_OPTIONAL="0"
# Recette locale d'un build de production uniquement (e-mails affichés dans le terminal). JAMAIS en production.
# ALLOW_CONSOLE_EMAIL="1"

# ───────────── V4 : facturation par zone, WhatsApp officiel ─────────────
# Fournisseur des abonnements et options par zone (manual par défaut)
PLATFORM_BILLING_PROVIDER_AFRICA="manual"   # manual | fedapay | kkiapay
PLATFORM_BILLING_PROVIDER_WORLD="manual"    # manual | stripe
FEDAPAY_MODE="sandbox"
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_MODE="sandbox"
# Coordonnées affichées en mode manuel
PLATFORM_MOMO_NUMBER="+229 01 00 00 00 00"
PLATFORM_BANK_DETAILS="IBAN à renseigner"
# ───────────── Stockage des médias (images) — docs/DEPLOIEMENT.md §6 bis ─────────────
# local (défaut en dev : fichiers dans .local/uploads, servis par /media/…) | s3 (production)
# En production : s3 obligatoire, sauf VPS à disque persistant (STORAGE_DRIVER=local explicite, avertissement au démarrage).
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=".local/uploads"
# S3 compatible — Cloudflare R2 (recommandé) : endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, région « auto »
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# URL publique des fichiers (domaine personnalisé du bucket ou CDN), en https. Lue au build (CSP img-src).
STORAGE_PUBLIC_URL=""
# 1 = style chemin (R2, Supabase, MinIO, Backblaze — défaut) ; 0 = hôte virtuel (AWS S3)
STORAGE_FORCE_PATH_STYLE="1"

# WhatsApp Cloud API (webhook /api/webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=""
# Secret de l'application Meta : vérifie la signature du webhook ET, en mode partenaire, l'échange du code Embedded Signup.
WHATSAPP_APP_SECRET=""

# Mode partenaire WhatsApp (Embedded Signup — Axi « fournisseur de technologies » Meta). Les marchands connectent
# leur numéro en quelques clics, sans recopier d'identifiants ; Axi s'abonne à leur WABA et enregistre le numéro.
# Branché seulement si les deux variables NEXT_PUBLIC_* sont définies AU BUILD (elles élargissent la CSP frame-src
# vers facebook.com et affichent le bouton « Connecter avec WhatsApp »). Prérequis côté Meta (porteur) :
# vérification de l'entreprise, « Devenir fournisseur de technologies » (revue de l'app), et une configuration
# Embedded Signup. La « ligne de crédit (paiement partagé) » se configure dans Meta Business Settings (hors Axi).
# App ID de l'application Meta (public).
NEXT_PUBLIC_META_APP_ID=""
# Identifiant de la configuration Embedded Signup (public), rubrique « Gestion des clients » de l'app Meta.
NEXT_PUBLIC_META_ESIGNUP_CONFIG_ID=""
# Secret d'application pour l'échange de code (facultatif : à défaut, WHATSAPP_APP_SECRET est utilisé — c'est le même secret).
META_APP_SECRET=""
# Expéditeur WhatsApp plateforme des codes de connexion acheteur : boutiques SANS WhatsApp Cloud et sur plan payant
# uniquement (jamais en repli d'un échec de crédit de la boutique). Modèle Meta de type « authentification ».
AXI_OTP_WHATSAPP_PHONE_ID=""
AXI_OTP_WHATSAPP_TOKEN=""
AXI_OTP_WHATSAPP_TEMPLATE="code_authentification"
AXI_OTP_WHATSAPP_LANGUAGE="fr"
# Budget quotidien (UTC) de l'expéditeur plateforme. Dépassé : arrêt d'urgence des comptes acheteurs activé
# automatiquement (PlatformSetting buyer_accounts.kill_switch) et alerte « admin.alert.buyer_otp_budget » au journal d'audit.
AXI_OTP_DAILY_BUDGET="2000"
# Plan Gratuit : codes envoyés par l'expéditeur plateforme, par boutique et par jour (compté aussi dans le budget global).
AXI_OTP_FREE_DAILY_PER_STORE="30"
# Défi anti-robot Cloudflare Turnstile (facultatif) sur la demande de code, exigé au-delà de AXI_OTP_CHALLENGE_AFTER
# demandes par IP et par heure. Vide = désactivé. Défini au build : la CSP autorise https://challenges.cloudflare.com
# (script-src, frame-src) automatiquement ; rebâtir après modification.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
AXI_OTP_CHALLENGE_AFTER="3"

# Notifications Web Push (lot 4D, RFC 8291 et 8292). Vide = notifications désactivées (aucun écran ne les propose).
# Génération d'une paire P-256 (base64url) : voir docs/vague3/CAN-lot4d.md.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@axi.africa"
